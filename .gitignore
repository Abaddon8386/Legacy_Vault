# ---------- Node / React ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.vite/
.npm-cache/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Java / Spring Boot / Maven ----------
target/
*.class
*.jar
*.war
*.log

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.iws
*.ipr
out/

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- Windows ----------
Thumbs.db
Desktop.ini

# ---------- OS / Temporary ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- Logs ----------
logs/
*.log

# ---------- Local database / generated files ----------
*.bak
*.db
*.sqlite
*.sqlite3

# Local Spring configuration / native authentication binaries
application-local.*
*.dll
