{
  "openapi": "3.0.3",
  "info": {
    "title": "Staff death document decision read extension",
    "version": "2026-11-02"
  },
  "paths": {
    "/api/v1/staff/verification-cases/{caseId}/death-documents": {
      "get": {
        "description": "Assigned Staff only; additive fields alongside existing metadata. Does not change business state.",
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decision scoped to each document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StaffDeathDocument"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Wrong role"
          },
          "404": {
            "description": "Case/document outside assigned Staff scope"
          }
        }
      }
    },
    "/api/v1/staff/verification-cases/{caseId}/death-documents/{recordId}": {
      "get": {
        "description": "Assigned Staff only; additive fields alongside existing metadata. Does not change business state.",
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decision scoped to each document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffDeathDocument"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Wrong role"
          },
          "404": {
            "description": "Case/document outside assigned Staff scope"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StaffDeathDocument": {
        "type": "object",
        "required": [
          "id",
          "caseId",
          "receivedBy",
          "receivedAt",
          "legalDecision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "receivedBy": {
            "type": "string",
            "format": "uuid"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "legalDecision": {
            "$ref": "#/components/schemas/LegalDecision"
          }
        }
      },
      "LegalDecision": {
        "type": "object",
        "nullable": true,
        "description": "null if this exact document has no Legal decision",
        "required": [
          "result",
          "reason",
          "decidedAt"
        ],
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "NEEDS_CORRECTION"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
