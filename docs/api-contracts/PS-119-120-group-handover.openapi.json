              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/staff/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "description": "Authenticated role-specific snapshot; Staff must be assigned, Legal uses existing workspace access. no-store.",
        "responses": {
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Outside scope"
          },
          "403": {
            "description": "Wrong role"
          },
          "200": {
            "description": "Current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/legal-verifications/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover": {
      "get": {
        "parameters": [
          {
            "in": "path",
