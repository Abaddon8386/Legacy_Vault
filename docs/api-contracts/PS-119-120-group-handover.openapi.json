{
  "openapi": "3.0.3",
  "info": {
    "title": "PS-119/120/122 whole-group handover API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "GroupMutation": {
        "required": [
          "expectedRevision",
          "presentRecipientIds",
          "reason"
        ],
        "properties": {
          "expectedRevision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "presentRecipientIds": {
            "type": "array",
            "description": "Direct beneficiaries physically present, as recorded by assigned Staff; empty means no one present.",
            "uniqueItems": true,
            "items": {
              "format": "uuid",
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "GroupDecision": {
        "required": [
          "expectedRevision",
          "decision",
          "reason"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "expectedRevision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "GroupReceipt": {
        "required": [
          "caseId",
          "sessionId",
          "eventId",
          "state",
          "notification"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "notification": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/GroupNotificationReceipt"
              }
            ],
            "description": "Null only for APPROVE/REJECT when the case has no assigned Staff. ATTENDANCE and REQUEST always carry a receipt (Legal workspace). A retry returns the receipt already recorded."
          },
          "state": {
            "$ref": "#/components/schemas/GroupState"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "type": "object"
      },
      "GroupRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "expectedRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "expectedRevision",
          "reason"
        ]
      },
      "GroupState": {
        "type": "object",
        "properties": {
          "allPresent": {
            "type": "boolean"
          },
          "snapshot": {
            "nullable": true,
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "attendanceId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "status": {
            "enum": [
              "UNCONFIRMED",
              "READY",
              "SUSPENDED",
              "AWAITING_LEGAL"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "revision",
          "allPresent"
        ]
      },
      "GroupView": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/GroupState"
          },
          "deliveryAllowed": {
            "type": "boolean"
          },
          "requiredRecipientIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "snapshot": {
            "type": "string"
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "caseNumber": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionStatus": {
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/GroupProgress"
          },
          "attendance": {
            "$ref": "#/components/schemas/GroupAttendance"
          },
          "request": {
            "$ref": "#/components/schemas/GroupReopenRequest"
          },
          "lastDecision": {
            "$ref": "#/components/schemas/GroupLegalDecision"
          },
          "capabilities": {
            "$ref": "#/components/schemas/GroupCapabilities"
          }
        },
        "type": "object",
        "description": "state, snapshot, requiredRecipientIds and deliveryAllowed are the PS-119/120 fields; the others were added by PS-122 (additive). Needs an OPEN session."
      },
      "GroupNotificationReceipt": {
        "type": "object",
        "description": "PS-135 receipt: the notification row was recorded in the same transaction. It does not claim delivery, display, reading or e-mail.",
        "required": [
          "id",
          "recipientWorkspace",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recipientWorkspace": {
            "type": "string",
            "enum": [
              "STAFF",
              "LEGAL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "RECORDED"
            ]
          }
        }
      },
      "GroupPerson": {
        "type": "object",
        "required": [
          "userId",
          "fullName"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          }
        }
      },
      "GroupAttendance": {
        "type": "object",
        "nullable": true,
        "properties": {
          "attendanceId": {
            "type": "string",
            "format": "uuid"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedBy": {
            "$ref": "#/components/schemas/GroupPerson"
          },
          "presentRecipientIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "GroupReopenRequest": {
        "type": "object",
        "nullable": true,
        "description": "Only while the state is AWAITING_LEGAL.",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "requestedBy": {
            "$ref": "#/components/schemas/GroupPerson"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "GroupLegalDecision": {
        "type": "object",
        "nullable": true,
        "description": "Latest Legal decision of the case; kept after it is made.",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedBy": {
            "$ref": "#/components/schemas/GroupPerson"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "GroupProgress": {
        "type": "object",
        "description": "Counts of the approved scope; absent people and undelivered assets never leave the totals.",
        "properties": {
          "totalAssets": {
            "type": "integer"
          },
          "deliveredAssets": {
            "type": "integer"
          },
          "requiredRecipients": {
            "type": "integer"
          },
          "presentRecipients": {
            "type": "integer"
          }
        }
      },
      "GroupCapabilities": {
        "type": "object",
        "description": "UI hints only; every mutation re-checks on the backend.",
        "properties": {
          "canRecordAttendance": {
            "type": "boolean"
          },
          "canRequestReopen": {
            "type": "boolean"
          },
          "canDecide": {
            "type": "boolean"
          },
          "deliveryBlockedReason": {
            "type": "string",
            "nullable": true,
            "enum": [
              "ATTENDANCE_REQUIRED",
              "MISSING_RECIPIENTS",
              "LEGAL_REOPEN_REQUIRED",
              "AWAITING_LEGAL_DECISION",
              "ATTENDANCE_STALE",
              "BLOCKED"
            ]
          }
        }
      },
      "GroupHistoryItem": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "operation": {
            "type": "string",
            "enum": [
              "ATTENDANCE",
              "REQUEST",
              "APPROVE",
              "REJECT"
            ]
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "resultingStatus": {
            "type": "string",
            "enum": [
              "UNCONFIRMED",
              "READY",
              "SUSPENDED",
              "AWAITING_LEGAL"
            ]
          },
          "allPresent": {
            "type": "boolean"
          },
          "presentRecipients": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "$ref": "#/components/schemas/GroupPerson"
          }
        }
      },
      "GroupHistoryPage": {
        "type": "object",
        "description": "Newest first; size 1..100.",
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupHistoryItem"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "GroupPendingReopenRequest": {
        "type": "object",
        "description": "A request Legal can decide right now; the item is dropped when the decision itself would be refused.",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "caseNumber": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "vaultName": {
            "type": "string"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "requestedBy": {
            "$ref": "#/components/schemas/GroupPerson"
          },
          "reason": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "allPresent": {
            "type": "boolean"
          },
          "requiredRecipients": {
            "type": "integer"
          },
          "presentRecipients": {
            "type": "integer"
          },
          "totalAssets": {
            "type": "integer"
          },
          "deliveredAssets": {
            "type": "integer"
          },
          "decidable": {
            "type": "boolean"
          }
        }
      },
      "GroupPendingReopenPage": {
        "type": "object",
        "description": "Oldest request first; size 1..100, default 20.",
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupPendingReopenRequest"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "BeneficiaryHandoverStatus": {
        "type": "object",
        "description": "Private status of the authenticated recipient account; the account comes only from the token. No other recipient, reason, attendance id, snapshot or actor data is returned.",
        "required": [
          "subjectId",
          "cases"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "caseId",
                "caseNumber",
                "status",
                "totalAssets",
                "deliveredAssets"
              ],
              "properties": {
                "caseId": {
                  "type": "string",
                  "format": "uuid"
                },
                "caseNumber": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "UNCONFIRMED",
                    "SUSPENDED",
                    "AWAITING_LEGAL",
                    "READY"
                  ],
                  "description": "READY is not DELIVERED."
                },
                "totalAssets": {
                  "type": "integer"
                },
                "deliveredAssets": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "paths": {
    "/api/v1/staff/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover/attendance": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "caseId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "description": "Implemented; server checks role, current assignment/session, legal approval and full direct-beneficiary scope under locks. 200 response is no-store.",
        "responses": {
          "200": {
            "description": "Persisted mutation receipt, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Existing ApiError envelope; see decision log for 401 semantics"
          },
          "403": {
            "description": "Existing ApiError envelope; see decision log for 403 semantics"
          },
          "404": {
            "description": "Existing ApiError envelope; see decision log for 404 semantics"
          },
          "409": {
            "description": "Existing ApiError envelope; see decision log for 409 semantics"
          },
          "400": {
            "description": "Existing ApiError envelope; see decision log for 400 semantics"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupMutation"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/staff/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover/reopen-requests": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "caseId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "description": "Implemented; server checks role, current assignment/session, legal approval and full direct-beneficiary scope under locks. 200 response is no-store.",
        "responses": {
          "200": {
            "description": "Persisted mutation receipt, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Existing ApiError envelope; see decision log for 401 semantics"
          },
          "403": {
            "description": "Existing ApiError envelope; see decision log for 403 semantics"
          },
          "404": {
            "description": "Existing ApiError envelope; see decision log for 404 semantics"
          },
          "409": {
            "description": "Existing ApiError envelope; see decision log for 409 semantics"
          },
          "400": {
            "description": "Existing ApiError envelope; see decision log for 400 semantics"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/legal-verifications/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover/reopen-requests/{requestId}/decision": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "caseId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "requestId",
            "in": "path"
          }
        ],
        "description": "Implemented; server checks role, current assignment/session, legal approval and full direct-beneficiary scope under locks. 200 response is no-store.",
        "responses": {
          "200": {
            "description": "Persisted mutation receipt, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Existing ApiError envelope; see decision log for 401 semantics"
          },
          "403": {
            "description": "Existing ApiError envelope; see decision log for 403 semantics"
          },
          "404": {
            "description": "Existing ApiError envelope; see decision log for 404 semantics"
          },
          "409": {
            "description": "Existing ApiError envelope; see decision log for 409 semantics"
          },
          "400": {
            "description": "Existing ApiError envelope; see decision log for 400 semantics"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupDecision"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/staff/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "description": "Authenticated role-specific snapshot; Staff must be assigned, Legal uses existing workspace access. no-store.",
        "responses": {
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Outside scope"
          },
          "403": {
            "description": "Wrong role"
          },
          "200": {
            "description": "Current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/legal-verifications/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "description": "Authenticated role-specific snapshot; Staff must be assigned, Legal uses existing workspace access. no-store.",
        "responses": {
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Outside scope"
          },
          "403": {
            "description": "Wrong role"
          },
          "200": {
            "description": "Current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/staff/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover/events": {
      "get": {
        "description": "PS-122 event history for the assigned Staff; readable after the session ends or the case is archived. A Staff who is not the assigned owner gets 404. no-store.",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Zero based"
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "1..100"
          }
        ],
        "responses": {
          "200": {
            "description": "OK, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupHistoryPage"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED: bad paging or filter"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Wrong role (STAFF_EXECUTOR only)"
          },
          "404": {
            "description": "Outside scope"
          }
        }
      }
    },
    "/api/v1/legal-verifications/verification-cases/{caseId}/handover-sessions/{sessionId}/group-handover/events": {
      "get": {
        "description": "PS-122 event history for Legal. no-store.",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "type": "string",
