          }
        ],
        "description": "Implemented; server checks role, current assignment/session, legal approval and full direct-beneficiary scope under locks. 200 response is no-store.",
        "responses": {
          "200": {
            "description": "Persisted mutation receipt, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Existing ApiError envelope; see decision log for 401 semantics"
